<!--
  CS2UIKit vote card, driven by CS2UIKit.Votes. Generated by kit/make_votes_layout.py.

  Rules of this file (see docs/GOTCHAS.md):
  - the root panel has no id (the resource compiler rejects it); the plugin toggles `votes` inside it;
  - only Panel, Label, Image and Button are allowed in custom_hud_layout, and no inline style="";
  - nothing here takes the mouse: votes are cast with F1…F5 and !1…!5, the cursor stays in the game.
-->
<root>
	<styles>
		<include src="s2r://panorama/styles/custom_game/cs2uikit_votes.vcss_c" />
	</styles>

	<Panel class="cs2uikit-screen" hittest="false">
		<Panel id="votes" class="votes" hittest="false">
			<Panel id="vote_card" class="vote-card" hittest="false">
				<Panel class="vote-head" hittest="false">
					<Label id="vote_header" class="vote-header" text="{s:text}" />
					<Label id="vote_time" class="vote-time" text="{s:text}" />
				</Panel>
				<Label id="vote_question" class="vote-question" text="{s:text}" />
				<Panel class="vote-options" hittest="false">
					<Panel id="vote_opt_0" class="vote-opt" hittest="false">
						<Panel class="vote-opt-row" hittest="false">
							<Label id="vote_key_0" class="vote-key" text="{s:text}" />
							<Label id="vote_label_0" class="vote-label" text="{s:text}" />
							<Label id="vote_count_0" class="vote-count" text="{s:text}" />
						</Panel>
						<Panel class="vote-bar" hittest="false">
							<Panel id="vote_fill_0" class="vote-fill" hittest="false" />
						</Panel>
					</Panel>
					<Panel id="vote_opt_1" class="vote-opt" hittest="false">
						<Panel class="vote-opt-row" hittest="false">
							<Label id="vote_key_1" class="vote-key" text="{s:text}" />
							<Label id="vote_label_1" class="vote-label" text="{s:text}" />
							<Label id="vote_count_1" class="vote-count" text="{s:text}" />
						</Panel>
						<Panel class="vote-bar" hittest="false">
							<Panel id="vote_fill_1" class="vote-fill" hittest="false" />
						</Panel>
					</Panel>
					<Panel id="vote_opt_2" class="vote-opt" hittest="false">
						<Panel class="vote-opt-row" hittest="false">
							<Label id="vote_key_2" class="vote-key" text="{s:text}" />
							<Label id="vote_label_2" class="vote-label" text="{s:text}" />
							<Label id="vote_count_2" class="vote-count" text="{s:text}" />
						</Panel>
						<Panel class="vote-bar" hittest="false">
							<Panel id="vote_fill_2" class="vote-fill" hittest="false" />
						</Panel>
					</Panel>
					<Panel id="vote_opt_3" class="vote-opt" hittest="false">
						<Panel class="vote-opt-row" hittest="false">
							<Label id="vote_key_3" class="vote-key" text="{s:text}" />
							<Label id="vote_label_3" class="vote-label" text="{s:text}" />
							<Label id="vote_count_3" class="vote-count" text="{s:text}" />
						</Panel>
						<Panel class="vote-bar" hittest="false">
							<Panel id="vote_fill_3" class="vote-fill" hittest="false" />
						</Panel>
					</Panel>
					<Panel id="vote_opt_4" class="vote-opt" hittest="false">
						<Panel class="vote-opt-row" hittest="false">
							<Label id="vote_key_4" class="vote-key" text="{s:text}" />
							<Label id="vote_label_4" class="vote-label" text="{s:text}" />
							<Label id="vote_count_4" class="vote-count" text="{s:text}" />
						</Panel>
						<Panel class="vote-bar" hittest="false">
							<Panel id="vote_fill_4" class="vote-fill" hittest="false" />
						</Panel>
					</Panel>
				</Panel>
				<Panel class="vote-timer" hittest="false">
					<Panel id="vote_timer_fill" class="vote-timer-fill" hittest="false" />
				</Panel>
				<Label id="vote_hint" class="vote-hint" text="{s:text}" />
			</Panel>
		</Panel>
	</Panel>
</root>
